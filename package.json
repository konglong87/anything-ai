{
  "name": "anything-ai",
  "version": "0.1.0",
  "description": "系统性AI知识索引 - 帮助人们认识、理解和驾驭AI | A systematic AI knowledge index - helping people understand and master AI",
  "keywords": [
    "ai",
    "artificial-intelligence",
    "knowledge-base",
    "learning",
    "prompts",
    "llm",
    "chatgpt",
    "claude",
    "deepseek",
    "tutorial",
    "guide"
  ],
  "author": "Anything-AI Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:konglong87/anything-ai.git"
  },
  "homepage": "https://github.com/konglong87/anything-ai#readme",
  "bugs": {
    "url": "https://github.com/konglong87/anything-ai/issues"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "index": "node scripts/generate-index.js",
    "check": "node scripts/check-frontmatter.js",
    "check:links": "node scripts/check-links.js",
    "stats": "node scripts/stats.js",
    "fix-urls": "node scripts/fix-readme-urls.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run check && npm run index && npm run docs:build && npm run fix-urls && npm run sitemap",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "exa-js": "^2.8.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

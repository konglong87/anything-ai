{
  "name": "anything-ai",
  "version": "0.1.0",
  "description": "系统性AI知识索引 - 帮助人们认识、理解和驾驭AI | A systematic AI knowledge index - helping people understand and master AI",
  "keywords": [
    "ai",
    "artificial-intelligence",
    "knowledge-base",
    "learning",
    "prompts",
    "llm",
    "chatgpt",
    "claude",
    "deepseek",
    "tutorial",
    "guide"
  ],
  "author": "Anything-AI Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:konglong87/anything-ai.git"
  },
  "homepage": "https://github.com/konglong87/anything-ai#readme",
  "bugs": {
    "url": "https://github.com/konglong87/anything-ai/issues"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "index": "node scripts/generate-index.js",
    "check": "node scripts/check-frontmatter.js",
    "stats": "node scripts/stats.js",
    "llms": "node scripts/generate-llms-txt.js",
    "fix-urls": "node scripts/fix-readme-urls.js",
    "fix-image-refs": "node scripts/fix-image-refs.js",
    "migrate-en-files": "node scripts/migrate-en-files.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run jargon:build && npm run test:jargon && npm run check && npm run index && npm run llms && npm run docs:build && npm run fix-urls && npm run sitemap && npm run jargon:verify",
    "test": "npm run test:jargon",
    "jargon:sync": "node scripts/jargon/sync.mjs",
    "jargon:build": "node scripts/jargon/generate.mjs",
    "test:jargon": "node --test tests/jargon/*.test.mjs",
    "jargon:verify": "node scripts/jargon/check-dist.mjs"
  },
  "devDependencies": {
    "exa-js": "^2.25.0",
    "gray-matter": "^4.0.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

      "termSkill": [
        "右侧固定操作区",
        "左侧状态筛选",
        "玻璃表格",
        "选中态联动"
      ],
      "uiSkill": {
        "background": "雾灰",
        "material": "玻璃表格",
        "layout": "左侧筛选 / 中部表格 / 右侧固定操作区"
      },
      "agentExec": [
        {
          "event": "filter_low_stock",
          "writes": [
            "stockFilter"
          ],
          "sets": {
            "stockFilter": 2
          },
          "updates": [
            "visibleRows"
          ],
          "preserves": [
            "replenishmentCount"
          ]
        },
        {
          "event": "select_item",
          "example": "选中 Prime 85mm",
          "writes": [
            "selectedItemId"
          ],
          "updates": [
            "replenishmentCard"
          ],
          "preserves": [
            "replenishmentCount"
          ]
        },
        {
          "event": "add_to_replenishment",
          "writes": [
            "replenishmentItems"
          ],
          "updates": [
            "replenishmentCount"
          ],
          "example_transition": {
            "before": 7,
            "after": 8
          },
          "guard": "成功加入一个新项目才增加；重复、失败与空选择不得重复计数"
        }
      ],
      "state": {
        "model_status": "proposed_implementation",
        "source": {
          "stockFilter": "st 筛选码；低库存 st=2",
          "selectedItemId": "稳定物料 ID，不用行号",
          "replenishmentItems": "待补货集合"
        },
        "derived": {
          "visibleRows": "items filtered by stockFilter",
          "replenishmentCard": "items[selectedItemId]",
          "replenishmentCount": "count(replenishmentItems)"
        },
        "invariants": [
          "筛选不应伪装成新增补货",
          "选中物料与补货卡一致",
          "7→8 是示例断言，不是写死计数；重复加入策略需确认"
        ]
      },
      "tokens": {
        "scope": "provided_example",
        "values": {
          "accent_hex": "#F3EB30",
          "secondary_accent_hex": "#FB9350",
          "grid_ratio": [
            1.02,
            1,
            0.72
          ],
          "first_row_px": 196,
          "row_height_px": 60
        }
      },
      "evidence": {
        "status": "provided",
        "source": "user_dashboard_brief",
        "state_model": "实现建议，不宣称为原始产品已有逻辑"

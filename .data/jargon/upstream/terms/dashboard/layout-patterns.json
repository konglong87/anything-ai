    {
      "id": "layout-patterns",
      "name": "高级布局模式",
      "plain_language": "用错位、大图、非对称、层叠、留白和破格出血建立布局性格。",
      "when_to_use": "Dashboard 需要有明确审美方向且避免模板化",
      "parameters": [
        "错位按 8/12/16px 节奏",
        "7:3 或 8:2 比例",
        "只破一处网格",
        "安全区内留信息"
      ],
      "related": [
        "design-tokens",
        "layout-patterns"
      ],
      "constraints": [
        "不要所有卡片一样大",
        "不要默认蓝紫渐变",
        "不要模板化侧边栏+四张 KPI 卡"
      ],
      "aliases": [
        "Dashboard三层规范",
        "术语视觉执行分层"
      ],
      "contract_ref": "templates/dashboard/dashboard-style-system.json"
    },
    {
      "id": "color-staggered-dashboard",
      "name": "多彩错列布局",
      "plain_language": "非对称双列；大卡主位；多彩卡片；斜纹/实心状态",
      "when_to_use": "需要多彩错列布局的信息结构、视觉参数与交互联动规范时",
      "parameters": [
        "grid_ratio",
        "radius_px",
        "title_weight"
      ],
      "related": [
        "high-contrast"
      ],
      "constraints": [
        "布局、视觉和执行状态分层；具体参数只属于本例，不作为同类页面默认值"
      ],
      "aliases": [
        "多彩错列",
        "非对称双列",
        "容量圆点独立切换"
      ],
      "contract_ref": "templates/dashboard/dashboard-style-system.json",
      "layout": "多彩错列布局",
      "termSkill": [
        "非对称双列",
        "大卡主位",
        "多彩卡片",
        "斜纹/实心状态"
      ],
      "uiSkill": {
        "background": "近黑",
        "palette": [
          "珊瑚",
          "长春花",
          "冰蓝",
          "鼠尾草"
        ],
        "hierarchy": "大卡主位，斜纹/实心区分状态"
      },
      "agentExec": [
        {
          "event": "select_day",
          "example": "点击 Thu",
          "writes": [
            "selectedDay"
          ],
          "updates": [
            "barSeries",
            "dayLabel"
          ],
          "preserves": [
            "capacitySelection"
          ]
        },
        {
          "event": "toggle_capacity",
          "example": "独立切换容量圆点",
          "writes": [
            "capacitySelection"
          ],
          "updates": [
            "capacityDots"
          ],
          "preserves": [
            "selectedDay"
          ]
        }
      ],
      "state": {
        "model_status": "proposed_implementation",
        "source": {
          "selectedDay": "用户选择的日期；不预设初值",
          "capacitySelection": "独立容量选择"
        },
        "derived": {
          "barSeries": "data[selectedDay].bars",
          "dayLabel": "selectedDay",
          "capacityDots": "capacitySelection"
        },
        "invariants": [
          "日期仅驱动柱形与标签；不改变容量选择",
          "容量操作不改变日期或柱形数据"
        ]
      },
      "tokens": {
        "scope": "provided_example",
        "values": {
          "grid_ratio": [
            1.42,
            1
          ],
          "radius_px": 26,
          "title_weight": 800
        }
      },
      "evidence": {
        "status": "provided",
        "source": "user_dashboard_brief",
        "state_model": "实现建议，不宣称为原始产品已有逻辑"
      }
    },
    {
      "id": "industrial-zones-dashboard",

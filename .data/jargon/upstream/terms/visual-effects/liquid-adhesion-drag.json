  "entries": [
    {
      "id": "liquid-adhesion-drag",
      "name": "液滴粘连拖拽",
      "plain_language": "拖动元素与原位之间生成液态粘连连接，距离增大时颈部收缩，超过阈值后断开并弹性回圆。",
      "when_to_use": "需要有视觉表现但必须同时控制 GPU、移动端和减少动态成本",
      "parameters": [
        "SVG path/metaball",
        "Canvas",
        "贝塞尔曲线",
        "spring"
      ],
      "related": [
        "performance-budget",
        "progressive-degradation",
        "reduced-motion"
      ],
      "constraints": [
        "动效必须可中断",
        "优先 transform/opacity",
        "不得以视觉效果掩盖可读性"
      ],
      "aliases": [],
      "performance_budget": [
        "粘连距离必须有上限",
        "断裂阈值要有迟滞避免抖动",
        "断裂后两端分别回弹"
      ],
      "fallback": [
        "不支持 SVG/Canvas 时退化为连接线或无粘连拖拽",
        "高负载时降低采样频率"
      ],
      "mobile_degradation": [
        "移动端减少路径采样点",
        "拖动期间阻止页面滚动但允许取消"
      ],
      "reduced_motion": [
        "减少动态时取消粘连形变，保留拖拽和命中结果"
      ],
      "acceptance": [
        "滚动或拖拽保持 60fps 目标",
        "降级后主任务仍可完成",
        "视觉层不影响文本对比度"
      ]
    }
  ]
}

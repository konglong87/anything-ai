  "schema_version": "1.0.0",
  "leaf_id": "reverse-animation",
  "domain_id": "digital-product-uiux",
  "subdomain_id": "interaction-motion",
  "title": "撤销反向动画",
  "knowledge_type": "technique",
  "scope": "general",
  "status": "published",
  "intent_ids": [
    "implement-animation",
    "audit-motion"
  ],
  "entries": [
    {
      "id": "reverse-path",
      "name": "沿原路径反向归位",
      "plain_language": "撤销时沿删除动画的反方向回到原位置，而不是重新淡入。",
      "when_to_use": "列表删除后恢复原项",
      "parameters": [
        "删除缩小+位移+淡出，撤销放大+反向位移+淡入",
        "删除 200–300ms，撤销 180–240ms"
      ],
      "related": [
        "flip-reentry",
        "velocity-inheritance"
      ],
      "constraints": [
        "必须保留原索引、尺寸和位置上下文"
      ],
      "aliases": []
    },
    {
      "id": "reentry-highlight",
      "name": "归位确认高亮",
      "plain_language": "元素回到原位后增加短暂高亮或脉冲，确认它确实回来了。",
      "when_to_use": "撤销后的状态需要被快速识别",
      "parameters": [
        "高亮 500–700ms",
        "不改变布局"
      ],
      "related": [
        "reverse-path"
      ],
      "constraints": [
        "不要用强烈闪烁造成干扰"
      ],
      "aliases": []
    },
    {
      "id": "reduced-motion",
      "name": "减少动态降级",
      "plain_language": "减少动态时保留进度、状态和结果，不强制播放位移动画。",
      "when_to_use": "用户开启 prefers-reduced-motion",
      "parameters": [
        "保留明确状态变化",
        "取消复杂路径和粒子"
      ],
      "related": [
        "accessibility"
      ],
      "constraints": [
        "不可因为降级而丢失撤销入口"
      ],
      "aliases": []
    }
  ]
}

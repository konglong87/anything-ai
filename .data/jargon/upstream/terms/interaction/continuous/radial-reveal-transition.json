        "返回时沿反向路径收回"
      ],
      "accessibility": [
        "键盘触发使用按钮中心作为安全圆心",
        "焦点在新页面可交互后移动",
        "prefers-reduced-motion 时取消扩散但保留状态切换"
      ],

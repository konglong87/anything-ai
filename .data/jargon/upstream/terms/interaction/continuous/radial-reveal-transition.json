      "name": "圆形扩散转场",
      "plain_language": "从真实点击位置捕获圆心，以 clip-path circle 扩散覆盖屏幕，完全覆盖后再显示新页面内容。",
      "when_to_use": "用户用自然语言描述联动、叠卡、吸附画线或圆形转场的感觉时",
      "parameters": [
        "捕获 pointer x/y",
        "最大半径覆盖最远屏幕角",
        "扩散 duration 300–500ms",
        "easing ease-out",
        "新页面在覆盖完成后进入"
      ],
      "related": [
        "follow",
        "snap",
        "interruption",
        "reduced-motion"
      ],
      "constraints": [
        "避免生硬切换",
        "动画顺序必须可验证",
        "必须支持中断和反向回退"
      ],
      "aliases": [
        "圆形扩散转场",
        "radial reveal transition"
      ],
      "state_machine": [
        "capture origin",
        "circle expand",
        "screen covered",
        "new content enter",
        "settled",
        "reverse on back"
      ],
      "animation_sequence": [
        "capture origin",
        "circle expand",
        "screen covered",
        "new content enter",
        "settled",

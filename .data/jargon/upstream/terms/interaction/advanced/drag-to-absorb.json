    {
      "id": "drag-to-absorb",
      "name": "拖到目标吸入",
      "plain_language": "拖拽元素靠近目标后目标张开，松手时元素缩小并吸入目标中心。",
      "when_to_use": "需要明确触发、阈值、取消、边界和键盘替代路径的复杂交互",
      "parameters": [
        "目标半径 1.2 倍或外扩 48px",
        "目标 scale 1.15",
        "元素缩至 0.2",
        "未命中回原位"
      ],
      "related": [
        "follow",
        "threshold",
        "snap",
        "interruption"
      ],
      "constraints": [
        "未达到阈值不能触发",
        "快速重复操作不叠加",
        "组件卸载时清理定时器和动画"
      ],
      "aliases": [],
      "state_machine": [
        "dragging",
        "hovering",
        "dropping",
        "absorbed",
        "returning"
      ],
      "accessibility": [
        "键盘移动和放置",
        "目标重叠时按优先级",
        "多点触控只认第一指"
      ],
      "acceptance": [
        "60fps",
        "手势和键盘结果一致",
        "取消后状态完全复位"
      ]
    }
  ]
}

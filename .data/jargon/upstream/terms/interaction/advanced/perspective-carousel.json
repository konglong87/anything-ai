  "entries": [
    {
      "id": "perspective-carousel",
      "name": "景随图换轮播",
      "plain_language": "拖动距离或速度达到阈值后切换，中心项放大，侧边项透视缩小。",
      "when_to_use": "需要明确触发、阈值、取消、边界和键盘替代路径的复杂交互",
      "parameters": [
        "距离超过 20% 或速度超过 0.5px/ms",
        "perspective 1000px",
        "侧项 scale 0.85",
        "无限循环无跳帧"
      ],
      "related": [
        "follow",
        "threshold",
        "snap",
        "interruption"
      ],
      "constraints": [
        "未达到阈值不能触发",
        "快速重复操作不叠加",
        "组件卸载时清理定时器和动画"
      ],
      "aliases": [],
      "state_machine": [
        "dragging",
        "snapping",
        "switching"
      ],
      "accessibility": [
        "aria-roledescription=carousel",
        "aria-current",
        "图片失败降级"
      ],
      "acceptance": [
        "60fps",
        "手势和键盘结果一致",
        "取消后状态完全复位"
      ]
    },
    {
      "id": "stacked-card-carousel",
      "name": "卡片层叠轮播",
      "plain_language": "三张卡片以缩放和 Y 轴偏移形成层叠，顶层跟随拖拽并轻微旋转，达到距离或速度阈值后飞出，下层补位。",
      "when_to_use": "需要卡片层级、拖拽跟手、飞出切换和循环补位的移动端轮播",
      "parameters": [
        "scale 0.92/0.96/1",
        "Y 偏移 16/8/0",
        "顶层最大旋转 8°",
        "拖过 1/3 宽度或速度 > 500 触发",
        "spring 280/26",
        "只剩一张时循环补位"
      ],
      "related": [
        "stack-card",
        "stack-card-expand",
        "follow",
        "threshold",
        "snap",
        "velocity-inheritance"
      ],
      "constraints": [
        "未达距离和速度阈值时回弹",
        "顶层飞出后下层平滑补位",
        "快速连滑不叠加旧回调",
        "卡片内容和操作区不能因旋转不可达"
      ],
      "aliases": [
        "卡片层叠轮播",
        "叠卡轮播",
        "卡片堆叠轮播",
        "stacked card carousel"
      ],
      "state_machine": [
        "idle",
        "dragging",
        "projecting",
        "flying-out",
        "promoting",
        "snapping",
        "settled"
      ],
      "animation_sequence": [
        "top card follows pointer",
        "threshold decision",
        "fly out or spring back",
        "next card promotes",
        "loop refill"
      ],
      "spatial_anchor": [
        "三层卡片共享中心轴",
        "Y 偏移按层级递减",
        "下层露边保持层级可见"
      ],
      "accessibility": [
        "键盘左右切换",
        "aria-roledescription=carousel",
        "aria-current 标记当前卡片",
        "减少动态时取消旋转和飞出"
      ],
      "acceptance": [
        "拖拽 1:1 跟手",
        "阈值判断稳定",
        "飞出后下层无跳帧补位",
        "只剩一张时循环不中断"
      ]
    }
  ]
